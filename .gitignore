# Build outputs
server/target/
mobile/ios/build/
mobile/ios/Frameworks/
# Generated by xcodegen from mobile/ios/project.yml
mobile/ios/*.xcodeproj/
mobile/android/.kotlin/
mobile/android/app/src/main/jniLibs/
relay/node_modules/
relay/.cloudflare/
relay/.wrangler/
build/
__pycache__/

# Machine-specific
local.properties
mobile/ios/Config/Signing.local.xcconfig

# Secrets — never commit
*.p8
*.key
*.jks
*.keystore
secrets*.json
.env*
# Firebase config for the Android app (see docs/push-android.md)
google-services.json

# macOS / Xcode / IDE noise
.DS_Store
xcuserdata/
*.xcuserstate
.idea/

# Local Claude Code settings
.claude/settings.local.json
