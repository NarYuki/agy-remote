    "Open in the agy CLI on %@ · updating live. Close it there to reply here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتوحة في agy CLI على %@ · التحديث مباشر. أغلقها هناك للرد من هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der agy CLI auf %@ geöffnet · Live-Aktualisierung. Schließe ihn dort, um hier zu antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abierto en la CLI de agy en %@ · actualización en tiempo real. Ciérralo allí para responder aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouverte dans la CLI agy sur %@ · mise à jour en direct. Fermez-la là-bas pour répondre ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתוח ב-agy CLI ב-%@ · מתעדכן בזמן אמת. סגור אותו שם כדי להשיב כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर agy CLI में खुली है · लाइव अपडेट हो रही है। यहाँ जवाब देने के लिए इसे वहाँ बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperta nella CLI agy su %@ · aggiornamento in tempo reale. Chiudila lì per rispondere qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のagy CLIで開いています · リアルタイム更新中。ここから返信するには、そちらで閉じてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ құрылғысындағы agy CLI ішінде ашық · тікелей жаңартылуда. Мұнда жауап беру үшін оны сол жақта жабыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 agy CLI에서 열려 있음 · 실시간 업데이트 중. 여기서 답장하려면 해당 기기에서 닫으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuka dalam agy CLI pada %@ · dikemas kini secara langsung. Tutup di sana untuk membalas di sini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geopend in de agy CLI op %@ · wordt live bijgewerkt. Sluit deze daar om hier te antwoorden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aberta na CLI do agy em %@ · atualizando em tempo real. Feche lá para responder aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открыт в agy CLI на %@ · обновляется в реальном времени. Закройте его там, чтобы ответить здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดอยู่ใน agy CLI บน %@ · อัปเดตแบบเรียลไทม์ ปิดที่นั่นเพื่อตอบกลับที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ üzerindeki agy CLI'da açık · canlı güncelleniyor. Buradan yanıtlamak için orada kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang mở trong agy CLI trên %@ · đang cập nhật trực tiếp. Hãy đóng ở đó để trả lời tại đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 %@ 的 agy CLI 中打开 · 实时更新中。在那边关闭后即可在此回复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已在 %@ 的 agy CLI 中開啟 · 即時更新中。在該處關閉即可從這裡回覆。"
          }
        }
      }
    },
