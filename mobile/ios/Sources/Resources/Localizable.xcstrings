    "When the agent asks before editing or running something, or asks you a question." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يستأذنك الوكيل قبل تعديل شيء أو تشغيله، أو يطرح عليك سؤالًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Agent vor dem Bearbeiten oder Ausführen nachfragt oder dir eine Frage stellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el agente pide confirmación antes de editar o ejecutar algo, o te hace una pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque l'agent demande confirmation avant de modifier ou d'exécuter quelque chose, ou vous pose une question."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהסוכן שואל לפני שהוא עורך או מריץ משהו, או שואל אותך שאלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब एजेंट कुछ एडिट करने या चलाने से पहले अनुमति मांगे, या आपसे कोई सवाल पूछे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando l'agente chiede conferma prima di modificare o eseguire qualcosa, o ti fa una domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントが編集や実行の前に確認を求めたとき、または質問したとき。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агент бірдеңені өңдеу не іске қосу алдында рұқсат сұрағанда немесе сізге сұрақ қойғанда."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 편집이나 실행 전에 확인을 요청하거나 질문할 때 알려줍니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila ejen bertanya sebelum mengedit atau menjalankan sesuatu, atau menanyakan soalan kepada anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer de agent toestemming vraagt om iets te bewerken of uit te voeren, of je een vraag stelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando o agente pede confirmação antes de editar ou executar algo, ou faz uma pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда агент запрашивает подтверждение перед редактированием или запуском либо задаёт вам вопрос."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเอเจนต์ขออนุญาตก่อนแก้ไขหรือรันคำสั่ง หรือถามคำถามคุณ"
