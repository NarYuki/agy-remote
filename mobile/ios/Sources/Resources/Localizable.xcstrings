    "Done — Settings has a dark mode now, and the build passes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم — أصبحت الإعدادات تدعم الوضع الداكن الآن، ونجح البناء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erledigt – die Einstellungen haben jetzt einen Dunkelmodus und der Build ist erfolgreich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listo — Ajustes ya tiene modo oscuro y la compilación pasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est fait — Paramètres dispose désormais d'un mode sombre, et le build passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בוצע — בהגדרות יש כעת מצב כהה, והבנייה עוברת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो गया — अब सेटिंग्स में डार्क मोड है और बिल्ड पास हो गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fatto — ora Impostazioni ha la modalità scura e la build va a buon fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了しました。設定にダークモードを追加し、ビルドも通っています。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайын — енді Баптауларда қараңғы режим бар және құрастыру сәтті өтті."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료했어요 — 설정에 다크 모드가 추가되었고, 빌드도 통과했어요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selesai — Tetapan kini mempunyai mod gelap, dan binaan berjaya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klaar — Instellingen heeft nu een donkere modus en de build slaagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pronto — Configurações agora tem modo escuro, e o build está passando."
          }
        },
        "ru" : {
          "stringUnit" : {
