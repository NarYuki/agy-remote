    "Find out when the agent finishes, fails, or needs your approval, even with the app closed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف متى ينتهي الوكيل، أو يفشل، أو يحتاج إلى موافقتك، حتى عند إغلاق التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfahre, wenn der Agent fertig ist, ein Fehler auftritt oder deine Freigabe benötigt wird – auch bei geschlossener App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entérate cuando el agente termine, falle o necesite tu aprobación, incluso con la app cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sachez quand l'agent termine, échoue ou a besoin de votre approbation, même lorsque l'app est fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבל עדכון כשהסוכן מסיים, נכשל או זקוק לאישורך, גם כשהאפליקציה סגורה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप बंद होने पर भी जानें कि एजेंट का काम कब पूरा हुआ, विफल हुआ या उसे आपकी मंज़ूरी चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un avviso quando l'agente termina, riscontra un errore o richiede la tua approvazione, anche ad app chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを閉じていても、エージェントの完了・失敗・承認待ちを通知で受け取れます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Қолданба жабық болса да, агент жұмысты аяқтағанда, қате шыққанда немесе растауыңыз қажет болғанда хабардар болыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 닫혀 있어도 에이전트가 작업을 완료하거나, 실패하거나, 승인이 필요할 때 알림을 받으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketahui apabila ejen selesai, gagal atau memerlukan kelulusan anda, walaupun aplikasi ditutup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie wanneer de agent klaar is, faalt of je goedkeuring nodig heeft, zelfs als de app gesloten is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiba quando o agente terminar, falhar ou precisar da sua aprovação, mesmo com o app fechado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Узнавайте, когда агент завершил работу, столкнулся с ошибкой или ждёт вашего подтверждения — даже если приложение закрыто."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้ทันทีเมื่อเอเจนต์ทำงานเสร็จ ล้มเหลว หรือต้องการการอนุมัติจากคุณ แม้จะปิดแอปอยู่ก็ตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kapalıyken bile ajan işini bitirdiğinde, başarısız olduğunda veya onayınız gerektiğinde haberdar olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận thông báo khi tác nhân hoàn tất, gặp lỗi hoặc cần bạn phê duyệt, ngay cả khi đã đóng ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使关闭应用，也能在智能体完成、失败或需要你批准时收到通知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使關閉 App，也能在代理程式完成、失敗或需要您核准時收到通知。"
          }
        }
      }
    },
