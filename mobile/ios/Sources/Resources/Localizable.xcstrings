    "%@ can't be sent: only images and text files from the phone are supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرسال %@: تُدعم الصور والملفات النصية من الهاتف فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht gesendet werden: Es werden nur Bilder und Textdateien vom Smartphone unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede enviar %@: solo se admiten imágenes y archivos de texto desde el teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’envoyer %@ : seuls les images et fichiers texte du téléphone sont pris en charge."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשלוח את %@: רק תמונות וקובצי טקסט מהטלפון נתמכים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ नहीं भेजा जा सकता: फ़ोन से केवल इमेज और टेक्स्ट फ़ाइलें समर्थित हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile inviare %@: dal telefono sono supportati solo immagini e file di testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を送信できません：スマートフォンからは画像とテキストファイルのみ対応しています。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ жіберілмейді: телефоннан тек суреттер мен мәтіндік файлдарға қолдау көрсетіледі."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 보낼 수 없습니다. 휴대폰의 이미지와 텍스트 파일만 지원됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak dapat dihantar: hanya imej dan fail teks daripada telefon yang disokong."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan niet worden verzonden: alleen afbeeldingen en tekstbestanden van de telefoon worden ondersteund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível enviar %@: apenas imagens e arquivos de texto do celular são compatíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ нельзя отправить: с телефона поддерживаются только изображения и текстовые файлы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่ง %@ ไม่ได้: รองรับเฉพาะรูปภาพและไฟล์ข้อความจากโทรศัพท์เท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gönderilemiyor: telefondan yalnızca görseller ve metin dosyaları desteklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể gửi %@: chỉ hỗ trợ ảnh và tệp văn bản từ điện thoại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法发送 %@：仅支持手机上的图片和文本文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法傳送 %@：僅支援從手機傳送圖片和文字檔。"
          }
        }
      }
    },
