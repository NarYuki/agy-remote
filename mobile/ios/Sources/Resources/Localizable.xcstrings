    "Allow notifications for AGY Remote in Settings to turn this on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالإشعارات لتطبيق AGY Remote في الإعدادات لتشغيل هذا الخيار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mitteilungen für AGY Remote in den Einstellungen, um dies zu aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite las notificaciones de AGY Remote en Ajustes para activar esta opción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez les notifications pour AGY Remote dans Réglages pour activer cette option."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאפשר התראות עבור AGY Remote בהגדרות כדי להפעיל זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे चालू करने के लिए सेटिंग में AGY Remote के लिए सूचनाओं की अनुमति दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti le notifiche per AGY Remote in Impostazioni per attivare questa opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これをオンにするには、「設定」でAGY Remoteの通知を許可してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мұны қосу үшін «Баптаулар» ішінде AGY Remote хабарландыруларына рұқсат етіңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기능을 켜려면 설정에서 AGY Remote의 알림을 허용하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benarkan pemberitahuan untuk AGY Remote dalam Tetapan untuk mengaktifkan ini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta meldingen voor AGY Remote toe in Instellingen om dit in te schakelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita notificações para o AGY Remote nos Ajustes para ativar esta opção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы включить эту функцию, разрешите уведомления для AGY Remote в Настройках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตการแจ้งเตือนสำหรับ AGY Remote ในการตั้งค่าเพื่อเปิดใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu açmak için Ayarlar'dan AGY Remote bildirimlerine izin verin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép thông báo cho AGY Remote trong Cài đặt để bật tính năng này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中为 AGY Remote 允许通知，以开启此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 AGY Remote 的通知權限以開啟此功能。"
          }
        }
      }
    },
    "Allowed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
