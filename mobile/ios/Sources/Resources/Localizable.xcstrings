    "Type the 6-digit number agy-connector shows on the computer. It proves this phone and that computer see each other." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل الرقم المكوّن من 6 أرقام الذي يعرضه agy-connector على الكمبيوتر. يثبت ذلك أن هذا الهاتف وذلك الكمبيوتر يرى كل منهما الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
