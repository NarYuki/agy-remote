    "Update available: %@. agy-connector installs it automatically unless automatic updates are off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوفر تحديث: %@. يثبّته agy-connector تلقائيًا ما لم تكن التحديثات التلقائية متوقفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Update verfügbar: %@. agy-connector installiert es automatisch, sofern automatische Updates nicht deaktiviert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualización disponible: %@. agy-connector la instala automáticamente, a menos que las actualizaciones automáticas estén desactivadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
