    "If the CLI and this app write to the same chat at once, agy keeps only one side's messages." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كتبت واجهة سطر الأوامر وهذا التطبيق في المحادثة نفسها في آنٍ واحد، يحتفظ agy برسائل طرف واحد فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die CLI und diese App gleichzeitig in denselben Chat schreiben, behält agy nur die Nachrichten einer Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the CLI and this app write to the same chat at once, agy keeps only one side's messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la CLI y esta app escriben en el mismo chat a la vez, agy solo conserva los mensajes de un lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la CLI et cette app écrivent en même temps dans la même discussion, agy ne conserve les messages que d'un seul côté."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אם ה-CLI והאפליקציה הזו כותבים לאותו צ'אט בו-זמנית, agy שומר רק את ההודעות של צד אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर CLI और यह ऐप एक ही समय में एक ही चैट में लिखते हैं, तो agy केवल एक तरफ़ के संदेश रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la CLI e questa app scrivono nella stessa chat contemporaneamente, agy conserva solo i messaggi di una delle due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLIとこのアプリから同じチャットに同時に書き込むと、agyは片方のメッセージのみを保持します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Егер CLI мен осы қолданба бір чатқа қатар жазса, agy тек бір тараптың хабарламаларын сақтайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI와 이 앱에서 같은 채팅에 동시에 입력하면 agy는 한쪽의 메시지만 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika CLI dan aplikasi ini menulis ke sembang yang sama serentak, agy hanya menyimpan mesej daripada satu pihak."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de CLI en deze app tegelijk naar dezelfde chat schrijven, bewaart agy alleen de berichten van één kant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a CLI e este app enviarem mensagens no mesmo chat ao mesmo tempo, o agy mantém apenas as de um lado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если CLI и это приложение одновременно отправляют сообщения в один чат, agy сохранит сообщения только одной стороны."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาก CLI และแอปนี้ส่งข้อความในแชทเดียวกันพร้อมกัน agy จะเก็บข้อความไว้เพียงฝั่งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI ve bu uygulama aynı sohbete aynı anda yazarsa agy yalnızca bir tarafın mesajlarını saklar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu CLI và ứng dụng này cùng ghi vào một cuộc trò chuyện cùng lúc, agy sẽ chỉ giữ lại tin nhắn của một bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 CLI 和此应用同时向同一个对话发送消息，agy 只会保留其中一方的消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若 CLI 與此 App 同時寫入同一個對話，agy 只會保留其中一方的訊息。"
          }
        }
      }
    },
