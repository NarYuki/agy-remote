    "Runs in agy's auto mode and allows every request once, without asking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل بالوضع التلقائي في agy ويسمح بكل طلب مرة واحدة دون سؤال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft im Auto-Modus von agy und erlaubt jede Anfrage einmalig, ohne nachzufragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta en el modo automático de agy y permite cada solicitud una vez, sin preguntar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'exécute en mode auto d'agy et autorise chaque demande une fois, sans confirmation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פועל במצב האוטומטי של agy ומאשר כל בקשה פעם אחת, בלי לשאול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy के ऑटो मोड में चलता है और बिना पूछे हर अनुरोध को एक बार अनुमति देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona in modalità automatica di agy e consente ogni richiesta una volta, senza chiedere conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agyの自動モードで実行し、すべてのリクエストを確認なしで1回ずつ許可します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy авто режимінде жұмыс істейді және әр сұранысқа бір рет сұрамай рұқсат береді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy의 자동 모드로 실행하며, 모든 요청을 확인 없이 한 번씩 허용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijalankan dalam mod auto agy dan membenarkan setiap permintaan sekali, tanpa bertanya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt in de automatische modus van agy en staat elk verzoek eenmalig toe, zonder te vragen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa no modo automático do agy e permite cada solicitação uma vez, sem perguntar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работает в авторежиме agy и однократно разрешает каждый запрос без подтверждения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำงานในโหมดอัตโนมัติของ agy และอนุญาตทุกคำขอแบบครั้งเดียวโดยไม่ต้องถาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy'nin otomatik modunda çalışır ve her isteğe sormadan bir kez izin verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạy ở chế độ tự động của agy và cho phép mọi yêu cầu một lần mà không cần hỏi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 agy 自动模式运行，无需询问即单次允许每个请求。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 agy 的自動模式執行，直接單次允許每項請求，無須詢問。"
          }
        }
      }
    },
