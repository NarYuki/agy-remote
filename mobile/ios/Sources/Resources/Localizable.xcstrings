    "agy reports the total only. For a breakdown by system prompt, files and messages, run /context in agy on your computer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض agy الإجمالي فقط. للحصول على تفصيل حسب توجيه النظام والملفات والرسائل، شغّل /context في agy على كمبيوترك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy meldet nur die Gesamtzahl. Für eine Aufschlüsselung nach System-Prompt, Dateien und Nachrichten führe /context in agy auf deinem Computer aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy reports the total only. For a breakdown by system prompt, files and messages, run /context in agy on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy solo informa el total. Para ver el desglose por instrucción del sistema, archivos y mensajes, ejecuta /context en agy en tu computadora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy n'indique que le total. Pour le détail par prompt système, fichiers et messages, exécutez /context dans agy sur votre ordinateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy מדווח רק על הסך הכול. לפירוט לפי הנחיית מערכת, קבצים והודעות, הרץ /context ב-agy במחשב שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy केवल कुल जानकारी दिखाता है। सिस्टम प्रॉम्प्ट, फ़ाइलों और संदेशों के अनुसार विवरण के लिए अपने कंप्यूटर पर agy में /context चलाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy segnala solo il totale. Per il dettaglio per prompt di sistema, file e messaggi, esegui /context in agy sul tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy は合計のみを報告します。システムプロンプト、ファイル、メッセージごとの内訳を見るには、コンピュータの agy で /context を実行してください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy тек жалпы көлемді көрсетеді. Жүйелік промпт, файлдар және хабарламалар бойынша толық ақпарат алу үшін компьютеріңіздегі agy ішінде /context пәрменін орындаңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy는 전체 합계만 표시합니다. 시스템 프롬프트, 파일, 메시지별 세부 내역을 보려면 컴퓨터의 agy에서 /context를 실행하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy hanya melaporkan jumlah keseluruhan. Untuk pecahan mengikut gesaan sistem, fail dan mesej, jalankan /context dalam agy pada komputer anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy geeft alleen het totaal door. Voor een overzicht per systeemprompt, bestanden en berichten voer je /context uit in agy op je computer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agy informa apenas o total. Para ver o detalhamento por prompt do sistema, arquivos e mensagens, execute /context no agy em seu computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy сообщает только общий объём. Чтобы увидеть разбивку по системному промпту, файлам и сообщениям, выполните /context в agy на компьютере."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy รายงานเฉพาะยอดรวมเท่านั้น หากต้องการดูรายละเอียดแยกตามพรอมต์ระบบ ไฟล์ และข้อความ ให้รัน /context ใน agy บนคอมพิวเตอร์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy yalnızca toplamı bildirir. Sistem istemi, dosyalar ve mesajlara göre döküm görmek için bilgisayarınızda agy içinde /context komutunu çalıştırın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy chỉ báo cáo tổng dung lượng. Để xem chi tiết theo prompt hệ thống, tệp và tin nhắn, hãy chạy /context trong agy trên máy tính của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy 仅报告总计用量。如需按系统提示词、文件和消息查看明细，请在电脑上的 agy 中运行 /context。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy 僅回報總計用量。若要查看系統提示詞、檔案與訊息的詳細分佈，請在電腦的 agy 中執行 /context。"
          }
        }
      }
    },
    "agy runs on your computer as usual. The connector only passes your messages to it and its replies back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل agy على كمبيوترك كالمعتاد. ينقل الموصّل رسائلك إليه ويعيد ردوده فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy läuft wie gewohnt auf deinem Computer. Der Connector leitet nur deine Nachrichten dorthin und die Antworten zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy runs on your computer as usual. The connector only passes your messages to it and its replies back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy se ejecuta en tu computadora como de costumbre. El conector solo le pasa tus mensajes y devuelve sus respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy fonctionne sur votre ordinateur comme d'habitude. Le connecteur se contente de lui transmettre vos messages et de vous renvoyer ses réponses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy רץ במחשב שלך כרגיל. ה-connector רק מעביר אליו את ההודעות שלך ומחזיר את התשובות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy आपके कंप्यूटर पर हमेशा की तरह चलता है। कनेक्टर केवल आपके संदेश उस तक और उसके जवाब आप तक पहुँचाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy viene eseguito sul tuo computer come al solito. Il connettore si limita a inoltrargli i tuoi messaggi e a restituire le sue risposte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy はいつも通りコンピュータ上で動作します。コネクタはメッセージと返信をやり取りするだけです。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy компьютеріңізде әдеттегідей жұмыс істейді. Коннектор тек сіздің хабарламаларыңызды оған, ал оның жауаптарын кері жібереді."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy는 평소처럼 컴퓨터에서 실행됩니다. 커넥터는 메시지와 답장을 전달하는 역할만 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy berjalan pada komputer anda seperti biasa. Penyambung hanya menghantar mesej anda kepadanya dan memulangkan balasannya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy draait gewoon op je computer zoals altijd. De connector geeft alleen jouw berichten door en stuurt de antwoorden terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agy continua rodando no seu computador como sempre. O conector apenas envia suas mensagens para ele e traz as respostas de volta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy работает на вашем компьютере как обычно. Коннектор лишь передаёт ему ваши сообщения и возвращает ответы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy ทำงานบนคอมพิวเตอร์ของคุณตามปกติ ตัวเชื่อมต่อทำหน้าที่เพียงส่งข้อความของคุณไปให้และส่งคำตอบกลับมาเท่านั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy bilgisayarınızda her zamanki gibi çalışır. Bağlayıcı yalnızca mesajlarınızı ona, yanıtlarını da size iletir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy chạy trên máy tính của bạn như bình thường. Trình kết nối chỉ chuyển tin nhắn của bạn đến agy và gửi câu trả lời về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy 会像往常一样在你的电脑上运行。连接器仅负责将你的消息发送给它，并将回复传回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy 會像平常一樣在你的電腦上執行。連接器只負責將你的訊息傳送給它，並將回覆傳回。"
          }
        }
      }
    },
