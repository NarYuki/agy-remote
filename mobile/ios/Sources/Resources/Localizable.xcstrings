        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleatorio elige una forma diferente cada vez que el agente empieza a pensar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
