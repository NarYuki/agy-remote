          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na primeira vez em que você responder a um chat iniciado na CLI interativa, você escolhe a pasta em que ele trabalha."
          }
        },
        "ru" : {
