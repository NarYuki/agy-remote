        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रैंडम हर बार एजेंट के सोचना शुरू करने पर एक अलग आकार चुनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Casuale sceglie una forma diversa ogni volta che l'agente inizia a pensare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ランダム」では、エージェントが思考を始めるたびに異なる形が選ばれます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Кездейсоқ» режимі агент ойлана бастаған сайын басқа пішін таңдайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무작위를 선택하면 에이전트가 생각을 시작할 때마다 다른 모양이 나타납니다."
          }
        },
        "ms" : {
          "stringUnit" : {
