    "Higher effort means more thorough responses, but takes longer and uses your limits faster." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجهد الأعلى يعني ردودًا أكثر شمولًا، لكنه يستغرق وقتًا أطول ويستهلك حصتك بشكل أسرع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höherer Aufwand sorgt für gründlichere Antworten, dauert aber länger und verbraucht deine Limits schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Higher effort means more thorough responses, but takes longer and uses your limits faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mayor esfuerzo produce respuestas más detalladas, pero tarda más y consume tus límites más rápido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un effort plus élevé offre des réponses plus approfondies, mais prend plus de temps et consomme vos limites plus rapidement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאמץ גבוה יותר מניב תשובות יסודיות יותר, אך לוקח יותר זמן ומנצל את המגבלות שלך מהר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अधिक प्रयास का मतलब है ज़्यादा गहन जवाब, लेकिन इसमें समय अधिक लगता है और आपकी लिमिट जल्दी खर्च होती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un impegno maggiore offre risposte più approfondite, ma richiede più tempo e consuma i tuoi limiti più velocemente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思考レベルが高いほど丁寧な回答になりますが、時間がかかり使用上限の消費も早くなります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жоғары ойлану деңгейі тиянақтырақ жауаптар береді, бірақ көбірек уақыт алады және лимиттеріңізді тезірек жұмсайды."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추론 강도를 높이면 더 꼼꼼하게 응답하지만 시간이 더 오래 걸리고 사용량 한도가 더 빨리 소진됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usaha lebih tinggi menghasilkan respons lebih teliti, tetapi mengambil masa lebih lama dan menggunakan had anda dengan lebih cepat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogere inspanning levert grondigere antwoorden op, maar duurt langer en verbruikt je limieten sneller."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais esforço gera respostas mais completas, mas leva mais tempo e consome seus limites mais rápido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Более высокий уровень усилий даёт более подробные ответы, но занимает больше времени и быстрее расходует лимиты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระดับความพยายามที่สูงขึ้นจะให้คำตอบที่ละเอียดยิ่งขึ้น แต่จะใช้เวลานานขึ้นและใช้ขีดจำกัดของคุณเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha yüksek efor daha kapsamlı yanıtlar sağlar, ancak daha uzun sürer ve limitlerinizi daha hızlı tüketir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mức nỗ lực cao hơn mang lại phản hồi kỹ lưỡng hơn, nhưng mất nhiều thời gian hơn và dùng hết hạn mức nhanh hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更高的思考强度能带来更详尽的回复，但耗时更长，也会更快消耗你的额度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較高的推理強度可提供更詳盡的回覆，但需要較長時間，也會更快消耗額度。"
          }
        }
      }
    },
