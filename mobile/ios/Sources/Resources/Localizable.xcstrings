            "value" : "Aggiornamento disponibile: %@. agy-connector lo installa automaticamente, a meno che gli aggiornamenti automatici non siano disattivati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートがあります: %@。自動アップデートがオフでない限り、agy-connector が自動でインストールします。"
          }
        },
        "kk" : {
          "stringUnit" : {
