    "The first time you reply to a chat started in the interactive CLI, you pick the folder it works in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في المرة الأولى التي تردّ فيها على محادثة بدأت في واجهة CLI التفاعلية، ستختار المجلد الذي تعمل فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du zum ersten Mal auf einen in der interaktiven CLI gestarteten Chat antwortest, wählst du den Ordner aus, in dem er arbeitet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first time you reply to a chat started in the interactive CLI, you pick the folder it works in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera vez que respondas a un chat iniciado en la CLI interactiva, elegirás la carpeta en la que trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La première fois que vous répondez à une discussion démarrée dans la CLI interactive, vous choisissez son dossier de travail."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בפעם הראשונה שאתה משיב לצ׳אט שהתחיל ב-CLI האינטראקטיבי, תבחר את התיקייה שבה הוא פועל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरैक्टिव CLI में शुरू हुई किसी चैट का पहली बार जवाब देते समय, आप वह फ़ोल्डर चुनते हैं जिसमें वह काम करेगी।"
