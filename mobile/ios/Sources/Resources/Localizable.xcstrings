    "Fixed — the session cookie expired mid-test. All tests pass." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإصلاح — انتهت صلاحية ملف تعريف ارتباط الجلسة أثناء الاختبار. جميع الاختبارات ناجحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behoben – das Session-Cookie ist mitten im Test abgelaufen. Alle Tests sind erfolgreich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixed — the session cookie expired mid-test. All tests pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corregido — la cookie de sesión caducó a mitad de la prueba. Todas las pruebas pasan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrigé — le cookie de session expirait en cours de test. Tous les tests réussissent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תוקן — תוקף עוגיית ההפעלה פג באמצע הבדיקה. כל הבדיקות עוברות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठीक हो गया — टेस्ट के बीच में सेशन कुकी एक्सपायर हो गई थी। सभी टेस्ट पास हो गए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risolto — il cookie di sessione scadeva a metà test. Tutti i test passano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正しました — テスト途中でセッションCookieの期限が切れていました。すべてのテストが成功しています。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түзетілді — тест ортасында сессия cookie файлының мерзімі өтіп кеткен. Барлық тест өтті."
          }
        },
        "ko" : {
          "stringUnit" : {
