            "state" : "translated",
            "value" : "ستحتاج إلى مسح رمز الاقتران مجددًا لإعادة الاتصال."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dich wieder zu verbinden, musst du den Kopplungscode erneut scannen."
          }
        },
        "es" : {
          "stringUnit" : {
