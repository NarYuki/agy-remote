    "Send a task, follow along as it runs, and approve each change before it happens — from the couch, the train, anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل مهمة، وتابع تنفيذها، ووافق على كل تغيير قبل حدوثه — من الأريكة، أو القطار، أو أي مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende eine Aufgabe, verfolge die Ausführung live und gib jede Änderung frei, bevor sie angewendet wird – vom Sofa, im Zug, von überall."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send a task, follow along as it runs, and approve each change before it happens — from the couch, the train, anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una tarea, síguela mientras se ejecuta y aprueba cada cambio antes de que ocurra, desde el sofá, el tren o cualquier lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez une tâche, suivez son exécution et approuvez chaque modification avant qu'elle ne soit appliquée — depuis votre canapé, le train ou n'importe où."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלח משימה, עקוב אחריה בזמן שהיא רצה ואשר כל שינוי לפני שהוא קורה — מהספה, מהרכבת, מכל מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई टास्क भेजें, उसके चलने के दौरान साथ-साथ देखें और हर बदलाव के लागू होने से पहले उसे मंज़ूरी दें — सोफ़े से, ट्रेन से, कहीं से भी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia un'attività, seguine l'esecuzione e approva ogni modifica prima che avvenga — dal divano, dal treno, ovunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タスクを送信し、実行の様子を見守り、変更を事前に承認できます。ソファでも電車の中でも、どこからでも。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тапсырма жіберіңіз, орындалуын бақылаңыз және әр өзгерісті енгізілмей тұрып растаңыз — диваннан, пойыздан, кез келген жерден."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소파에서든, 기차에서든, 어디서나 작업을 보내고 실행 과정을 지켜보며 모든 변경 사항을 적용 전에 승인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hantar tugasan, ikuti perkembangannya semasa ia berjalan, dan luluskan setiap perubahan sebelum ia berlaku — dari sofa, kereta api, atau di mana-mana sahaja."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur een taak, kijk mee terwijl deze wordt uitgevoerd en keur elke wijziging goed voordat die wordt doorgevoerd — vanaf de bank, in de trein, overal."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie uma tarefa, acompanhe a execução e aprove cada alteração antes que aconteça — do sofá, do trem, de qualquer lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте задачи, следите за их выполнением и подтверждайте каждое изменение заранее — с дивана, из поезда, откуда угодно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งงาน ติดตามการทำงาน และอนุมัติทุกการเปลี่ยนแปลงก่อนเริ่มดำเนินการ — ไม่ว่าจะอยู่บนโซฟา บนรถไฟ หรือที่ไหนก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir görev gönderin, çalışırken takip edin ve her değişikliği uygulanmadan önce onaylayın — koltuktan, trenden, her yerden."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi tác vụ, theo dõi quá trình chạy và phê duyệt từng thay đổi trước khi áp dụng — ngay trên ghế sofa, trên tàu hay ở bất cứ đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随时随地发送任务、实时跟进运行进度，并在每项更改生效前进行审批——无论是在沙发上、火车上，还是任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送任務、即時追蹤執行進度，並在每項變更套用前先行核准——無論在沙發上、火車上，還是任何地方。"
          }
        }
      }
    },
