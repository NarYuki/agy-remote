    "They update live. Close the chat in the CLI to reply from your phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحدّث مباشرةً. أغلق المحادثة في CLI للرد من هاتفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden live aktualisiert. Schließe den Chat in der CLI, um vom Smartphone aus zu antworten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They update live. Close the chat in the CLI to reply from your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se actualizan en tiempo real. Cierra el chat en la CLI para responder desde tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles se mettent à jour en direct. Fermez la discussion dans la CLI pour répondre depuis votre téléphone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הם מתעדכנים בזמן אמת. סגור את הצ'אט ב-CLI כדי להשיב מהטלפון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे लाइव अपडेट होते हैं। अपने फ़ोन से जवाब देने के लिए CLI में चैट बंद करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aggiornano in tempo reale. Chiudi la chat nella CLI per rispondere dal telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムで更新されます。スマートフォンから返信するには、CLI でチャットを閉じてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Олар нақты уақытта жаңарады. Телефоннан жауап беру үшін CLI-дегі чатты жабыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간으로 업데이트됩니다. 휴대전화에서 답장하려면 CLI에서 대화를 닫으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia dikemas kini secara langsung. Tutup sembang dalam CLI untuk membalas daripada telefon anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze worden live bijgewerkt. Sluit de chat in de CLI om vanaf je telefoon te antwoorden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles são atualizados em tempo real. Feche o chat na CLI para responder pelo celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они обновляются в реальном времени. Закройте чат в CLI, чтобы отвечать с телефона."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปเดตแบบเรียลไทม์ ปิดแชทใน CLI เพื่อตอบกลับจากโทรศัพท์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı olarak güncellenirler. Telefonunuzdan yanıtlamak için CLI'daki sohbeti kapatın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nội dung cập nhật trực tiếp. Đóng cuộc trò chuyện trên CLI để trả lời từ điện thoại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话会实时更新。在 CLI 中关闭该对话后，即可在手机上回复。"
