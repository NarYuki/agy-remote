    "This phone's push address, an ID for your computer, the time, and a locked message that is always the same size. Never the chat name or what was said." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنوان الإشعارات الفورية لهذا الهاتف، ومعرّف لكمبيوترك، والوقت، ورسالة مقفلة بنفس الحجم دائمًا. ولا يشمل أبدًا اسم المحادثة أو ما قيل فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
