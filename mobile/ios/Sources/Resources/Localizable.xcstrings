        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prima volta che rispondi a una chat avviata nella CLI interattiva, scegli la cartella in cui lavora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対話型CLIで開始したチャットに初めて返信する際、作業フォルダを選択します。"
