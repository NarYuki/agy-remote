    "This app needs agy-connector %@ or newer. On this computer, run agy-connector update (or brew upgrade agy-connector if you installed it with Homebrew), then restart it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج هذا التطبيق إلى agy-connector %@ أو أحدث. على هذا الكمبيوتر، شغّل agy-connector update (أو brew upgrade agy-connector إذا ثبّته عبر Homebrew)، ثم أعد تشغيله."
          }
        },
        "de" : {
          "stringUnit" : {
