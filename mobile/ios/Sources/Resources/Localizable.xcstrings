    "Random picks a different shape each time the agent starts thinking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار «عشوائي» شكلاً مختلفاً في كل مرة يبدأ فيها الوكيل بالتفكير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
