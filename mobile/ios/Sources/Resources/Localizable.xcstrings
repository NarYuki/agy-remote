          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכון זמין: %@. agy-connector מתקין אותו אוטומטית אלא אם עדכונים אוטומטיים כבויים."
          }
        },
        "hi" : {
          "stringUnit" : {
