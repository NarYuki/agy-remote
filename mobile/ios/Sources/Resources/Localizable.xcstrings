    "Nothing is shown for the chat you have open. Approval notifications can be answered with Allow or Deny without opening the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُعرض أي شيء للمحادثة المفتوحة حالياً. يمكن الرد على إشعارات الموافقة بـ «سماح» أو «رفض» دون فتح التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für den aktuell geöffneten Chat wird nichts angezeigt. Benachrichtigungen zu Genehmigungen können mit „Erlauben“ oder „Ablehnen“ beantwortet werden, ohne die App zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se muestra nada para el chat que tienes abierto. Las notificaciones de aprobación pueden responderse con Permitir o Denegar sin abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne s'affiche pour la discussion ouverte. Vous pouvez répondre aux notifications d'approbation par Autoriser ou Refuser sans ouvrir l'app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא מוצג דבר עבור הצ'אט הפתוח אצלך. ניתן להשיב להתראות אישור באמצעות ״אפשר״ או ״דחה״ בלי לפתוח את האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो चैट आपने खोल रखी है, उसके लिए कुछ भी नहीं दिखाया जाता। मंज़ूरी के नोटिफ़िकेशन का जवाब ऐप खोले बिना 'अनुमति दें' या 'अस्वीकार करें' से दिया जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non viene mostrato nulla per la chat aperta. Puoi rispondere alle notifiche di approvazione con Consenti o Rifiuta senza aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いているチャットについては通知は表示されません。承認通知はアプリを開かずに「許可」または「拒否」で応答できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ашық тұрған чат үшін ештеңе көрсетілмейді. Растау хабарландыруларына қолданбаны ашпай-ақ «Рұқсат ету» немесе «Тыйым салу» арқылы жауап беруге болады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 열어 둔 채팅에는 알림이 표시되지 않습니다. 승인 알림은 앱을 열지 않고도 허용 또는 거부로 응답할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada apa-apa dipaparkan untuk sembang yang sedang dibuka. Pemberitahuan kelulusan boleh dijawab dengan Benarkan atau Tolak tanpa membuka apl."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor de chat die je open hebt wordt niets getoond. Goedkeuringsmeldingen kun je beantwoorden met Toestaan of Weigeren zonder de app te openen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada é exibido para a conversa aberta. Notificações de aprovação podem ser respondidas com Permitir ou Negar sem abrir o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для открытого сейчас чата уведомления не показываются. На запросы подтверждения можно отвечать кнопками «Разрешить» или «Отклонить», не открывая приложение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะไม่แสดงการแจ้งเตือนสำหรับแชทที่คุณเปิดอยู่ คุณสามารถตอบกลับการแจ้งเตือนการอนุมัติด้วยอนุญาตหรือไม่อนุญาตได้โดยไม่ต้องเปิดแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açık olan sohbet için bildirim gösterilmez. Onay bildirimleri, uygulamayı açmadan İzin Ver veya Reddet ile yanıtlanabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có thông báo nào hiển thị cho cuộc trò chuyện bạn đang mở. Bạn có thể phản hồi thông báo phê duyệt bằng Cho phép hoặc Từ chối mà không cần mở ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前打开的对话不会显示通知。对于审批通知，无需打开应用即可直接选择“允许”或“拒绝”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前開啟的對話不會顯示通知。你無須開啟 App，即可直接在核准通知中選擇「允許」或「拒絕」。"
          }
        }
      }
    },
