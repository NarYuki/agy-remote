    "AGY Remote has no server of its own and no account. Your phone connects straight to agy-connector on your computer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمتلك AGY Remote خادمًا خاصًا ولا يتطلب حسابًا. يتصل هاتفك مباشرةً بـ agy-connector على جهاز الكمبيوتر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote hat keinen eigenen Server und kein Konto. Dein Smartphone verbindet sich direkt mit agy-connector auf deinem Computer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote has no server of its own and no account. Your phone connects straight to agy-connector on your computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote no tiene servidor propio ni requiere cuenta. Tu teléfono se conecta directamente a agy-connector en tu ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote n’a ni serveur propre ni compte. Votre téléphone se connecte directement à agy-connector sur votre ordinateur."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ל-AGY Remote אין שרת משלה ואין חשבון. הטלפון שלך מתחבר ישירות ל-agy-connector במחשב שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote का अपना कोई सर्वर या अकाउंट नहीं है। आपका फ़ोन सीधे आपके कंप्यूटर पर मौजूद agy-connector से जुड़ता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote non ha server propri né account. Il telefono si connette direttamente ad agy-connector sul tuo computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remoteは独自サーバーもアカウントも使用しません。スマートフォンはコンピュータ上のagy-connectorに直接接続します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote қолданбасының өз сервері де, аккаунты да жоқ. Телефоныңыз компьютеріңіздегі agy-connector қызметіне тікелей қосылады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote는 자체 서버나 계정이 없습니다. 휴대폰이 컴퓨터의 agy-connector에 직접 연결됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote tidak mempunyai pelayan sendiri atau akaun. Telefon anda bersambung terus ke agy-connector pada komputer anda."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote heeft geen eigen server en geen account. Je telefoon maakt rechtstreeks verbinding met agy-connector op je computer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AGY Remote não tem servidor próprio nem conta. Seu celular se conecta diretamente ao agy-connector no seu computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У AGY Remote нет собственного сервера и учётных записей. Телефон подключается напрямую к agy-connector на вашем компьютере."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote ไม่มีเซิร์ฟเวอร์ของตัวเองและไม่ต้องใช้บัญชี โทรศัพท์ของคุณจะเชื่อมต่อโดยตรงกับ agy-connector บนคอมพิวเตอร์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote'un kendi sunucusu ve hesabı yoktur. Telefonunuz doğrudan bilgisayarınızdaki agy-connector'a bağlanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote không có máy chủ riêng và không cần tài khoản. Điện thoại của bạn kết nối trực tiếp với agy-connector trên máy tính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote 没有自有服务器，也无需账号。你的手机会直接连接到电脑上的 agy-connector。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AGY Remote 沒有自有伺服器，也無需帳號。您的手機會直接連線到電腦上的 agy-connector。"
          }
        }
      }
    },
