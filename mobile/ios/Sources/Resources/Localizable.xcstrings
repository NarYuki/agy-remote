          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willekeurig kiest telkens een andere vorm wanneer de agent begint te denken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aleatório escolhe uma forma diferente cada vez que o agente começa a pensar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме «Случайно» каждый раз выбирается другая фигура, когда агент начинает думать."
