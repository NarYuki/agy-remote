    "Approve edits and safe commands; ask before irreversible actions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموافقة على التعديلات والأوامر الآمنة، والسؤال قبل الإجراءات غير القابلة للتراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen und sichere Befehle genehmigen; vor unumkehrbaren Aktionen fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba ediciones y comandos seguros; pregunta antes de acciones irreversibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuve les modifications et les commandes sûres ; demande confirmation avant toute action irréversible."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אישור עריכות ופקודות בטוחות; בקשת אישור לפני פעולות בלתי הפיכות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलावों और सुरक्षित कमांड को मंज़ूरी दें; अपरिवर्तनीय कार्रवाइयों से पहले पूछें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva modifiche e comandi sicuri; chiede conferma prima di azioni irreversibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集と安全なコマンドを承認し、元に戻せない操作の前に確認します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Түзетулер мен қауіпсіз пәрмендерді мақұлдау; қайтымсыз әрекеттер алдында сұрау."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집과 안전한 명령을 승인하고, 되돌릴 수 없는 작업 전에 확인을 요청합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luluskan suntingan dan arahan selamat; tanya sebelum tindakan yang tidak boleh diundur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen en veilige opdrachten goedkeuren; eerst vragen bij onomkeerbare acties."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprova edições e comandos seguros; pergunta antes de ações irreversíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрять правки и безопасные команды; спрашивать перед необратимыми действиями."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุมัติการแก้ไขและคำสั่งที่ปลอดภัย และถามก่อนดำเนินการที่ย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenlemeleri ve güvenli komutları onaylar; geri alınamaz işlemlerden önce sorar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phê duyệt chỉnh sửa và lệnh an toàn; hỏi trước các hành động không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动批准编辑和安全命令；执行不可逆操作前询问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核准編輯與安全指令；執行無法復原的操作前先詢問。"
          }
        }
      }
    },
