    "No camera found on this device. Paste the agy-rem://pair code instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم العثور على كاميرا على هذا الجهاز. الصق رمز agy-rem://pair بدلاً من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät wurde keine Kamera gefunden. Füge stattdessen den agy-rem://pair-Code ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ninguna cámara en este dispositivo. Pega el código agy-rem://pair en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune caméra détectée sur cet appareil. Collez plutôt le code agy-rem://pair."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נמצאה מצלמה במכשיר זה. הדבק במקום זאת את הקוד agy-rem://pair."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर कोई कैमरा नहीं मिला। इसके बजाय agy-rem://pair कोड पेस्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna fotocamera trovata su questo dispositivo. Incolla invece il codice agy-rem://pair."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスでカメラが見つかりません。代わりに agy-rem://pair コードをペーストしてください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл құрылғыда камера табылмады. Оның орнына agy-rem://pair кодын қойыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 카메라를 찾을 수 없습니다. 대신 agy-rem://pair 코드를 붙여넣으세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada kamera ditemui pada peranti ini. Tampal kod agy-rem://pair sebaliknya."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen camera gevonden op dit apparaat. Plak in plaats daarvan de agy-rem://pair-code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma câmera encontrada neste dispositivo. Em vez disso, cole o código agy-rem://pair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
