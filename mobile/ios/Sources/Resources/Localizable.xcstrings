    "agy-connector must be running. If a direct connection isn't possible, you're asked before a relay is used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون agy-connector قيد التشغيل. إذا تعذّر الاتصال المباشر، سيُطلب إذنك قبل استخدام خادم ترحيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector muss laufen. Falls keine direkte Verbindung möglich ist, wirst du gefragt, bevor ein Relay verwendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector must be running. If a direct connection isn't possible, you're asked before a relay is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector debe estar en ejecución. Si no es posible una conexión directa, se te preguntará antes de usar un retransmisor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector doit être en cours d'exécution. Si une connexion directe est impossible, votre accord est demandé avant d'utiliser un relais."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector חייב לפעול. אם חיבור ישיר אינו אפשרי, תישאל לפני שימוש בממסר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector का चलना आवश्यक है। यदि सीधा कनेक्शन संभव न हो, तो रिले का उपयोग करने से पहले आपसे पूछा जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector deve essere in esecuzione. Se non è possibile stabilire una connessione diretta, ti verrà chiesta conferma prima di usare un relay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector が起動している必要があります。直接接続できない場合は、リレーを使用する前に確認が表示されます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector іске қосылып тұруы керек. Тікелей қосылу мүмкін болмаса, ретрансляторды пайдаланбас бұрын сізден сұралады."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector가 실행 중이어야 합니다. 직접 연결할 수 없는 경우 릴레이를 사용하기 전에 먼저 확인을 요청합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector mesti sedang berjalan. Jika sambungan langsung tidak dapat dilakukan, anda akan ditanya sebelum geganti digunakan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector moet actief zijn. Als een directe verbinding niet mogelijk is, wordt je om toestemming gevraagd voordat een relay wordt gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O agy-connector precisa estar em execução. Se não for possível fazer uma conexão direta, perguntaremos antes de usar um relay."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector должен быть запущен. Если прямое подключение невозможно, приложение спросит разрешение перед использованием ретранслятора."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector ต้องทำงานอยู่ หากเชื่อมต่อโดยตรงไม่ได้ ระบบจะถามคุณก่อนใช้รีเลย์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector çalışıyor olmalıdır. Doğrudan bağlantı mümkün değilse aktarıcı kullanılmadan önce size sorulur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector phải đang chạy. Nếu không thể kết nối trực tiếp, ứng dụng sẽ hỏi bạn trước khi dùng máy chủ chuyển tiếp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "agy-connector 必须保持运行。如果无法直连，在使用中继前会先征求你的同意。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必須正在執行 agy-connector。若無法直接連線，系統會在使用中繼伺服器前先徵詢你的同意。"
          }
        }
      }
    },
