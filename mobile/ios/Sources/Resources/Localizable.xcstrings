    "Ask before edits and commands, per your permission settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السؤال قبل التعديلات والأوامر وفقًا لإعدادات الأذونات لديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor Änderungen und Befehlen gemäß deinen Berechtigungseinstellungen fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta antes de realizar ediciones y ejecutar comandos, según tu configuración de permisos."
          }
        },
        "fr" : {
          "stringUnit" : {
