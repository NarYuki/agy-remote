          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिक्टेट करते समय आपकी बोली को प्रॉम्प्ट टेक्स्ट में बदलें।"
          }
        },
        "it" : {
          "stringUnit" : {
