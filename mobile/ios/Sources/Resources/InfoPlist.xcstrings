    "NSCameraUsageDescription" : {
      "comment" : "Camera permission",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقط صوراً لإرفاقها بالطلبات وامسح رمز الإقران الذي يعرضه agy-connector."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm Fotos auf, um sie an Prompts anzuhängen, und scanne den von agy-connector angezeigten Kopplungscode."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take photos to attach to prompts and scan the pairing code shown by agy-connector."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma fotos para adjuntar a los mensajes y escanea el código de emparejamiento que muestra agy-connector."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez des photos à joindre aux prompts et scannez le code d'association affiché par agy-connector."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צלם תמונות לצירוף להנחיות וסרוק את קוד הצימוד המוצג על ידי agy-connector."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रॉम्प्ट के साथ संलग्न करने के लिए फ़ोटो लें और agy-connector द्वारा दिखाया गया पेयरिंग कोड स्कैन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta foto da allegare ai prompt e scansiona il codice di abbinamento mostrato da agy-connector."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトに添付する写真を撮影したり、agy-connector に表示されるペアリングコードをスキャンしたりするために使用します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сұрауларға тіркеу үшін фотосурет түсіріңіз және agy-connector көрсеткен жұптау кодын сканерлеңіз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트에 첨부할 사진을 촬영하고 agy-connector에 표시된 페어링 코드를 스캔하는 데 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambil foto untuk dilampirkan pada gesaan dan imbas kod gandingan yang dipaparkan oleh agy-connector."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak foto's om aan prompts toe te voegen en scan de koppelingscode die door agy-connector wordt weergegeven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire fotos para anexar aos prompts e escaneie o código de pareamento exibido pelo agy-connector."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Делайте фото для прикрепления к запросам и сканируйте код сопряжения, отображаемый agy-connector."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายรูปเพื่อแนบไปกับพรอมต์และสแกนรหัสจับคู่ที่ agy-connector แสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstemlere eklemek için fotoğraf çekin ve agy-connector tarafından gösterilen eşleştirme kodunu tarayın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chụp ảnh để đính kèm vào câu lệnh và quét mã ghép nối do agy-connector hiển thị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍摄照片以附加到提示词，并扫描 agy-connector 显示的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍攝照片以附加至提示，並掃描 agy-connector 顯示的配對碼。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل مباشرةً بـ agy-connector عندما يكون جهاز الكمبيوتر الخاص بك على الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich direkt mit agy-connector, wenn sich dein Computer im selben Netzwerk befindet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect directly to agy-connector when your computer is on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conéctate directamente a agy-connector cuando tu computadora esté en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous directement à agy-connector lorsque votre ordinateur est sur le même réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התחבר ישירות אל agy-connector כאשר המחשב שלך נמצא באותה רשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आपका कंप्यूटर उसी नेटवर्क पर हो, तो agy-connector से सीधे कनेक्ट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connettiti direttamente a agy-connector quando il tuo computer si trova sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータが同じネットワーク上にあるときに、agy-connector へ直接接続するために使用します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компьютеріңіз сол желіде болғанда agy-connector қызметіне тікелей қосылыңыз."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터가 같은 네트워크에 있을 때 agy-connector에 직접 연결하는 데 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambung terus ke agy-connector apabila komputer anda berada pada rangkaian yang sama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak rechtstreeks verbinding met agy-connector wanneer je computer op hetzelfde netwerk zit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte-se diretamente ao agy-connector quando o computador estiver na mesma rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прямое подключение к agy-connector, когда ваш компьютер находится в той же сети."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เชื่อมต่อโดยตรงกับ agy-connector เมื่อคอมพิวเตอร์ของคุณอยู่ในเครือข่ายเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilgisayarınız aynı ağdayken doğrudan agy-connector'a bağlanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết nối trực tiếp với agy-connector khi máy tính của bạn ở cùng mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当电脑位于同一网络时，直接连接到 agy-connector。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當電腦位於相同網路時，直接連線至 agy-connector。"
          }
        }
      }
    },
