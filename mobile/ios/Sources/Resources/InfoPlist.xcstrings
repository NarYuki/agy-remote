    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Speech recognition permission",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحوّل كلامك إلى نص للطلب أثناء الإملاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wandelt deine Sprache beim Diktieren in Prompt-Text um."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your speech into prompt text while dictating."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convierte tu voz en texto del mensaje mientras dictas."
          }
