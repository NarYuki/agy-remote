<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (allowBackup is false, this is belt and braces). The phone's iroh secret key
     and the pairing tickets live in shared_prefs/agy-remote.xml and must never leave the device. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
