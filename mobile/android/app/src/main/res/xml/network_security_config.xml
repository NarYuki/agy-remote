<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to the computer over iroh QUIC (its own TLS), not HTTP. No cleartext anywhere,
     and only the system CA store (no user-installed CAs). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
